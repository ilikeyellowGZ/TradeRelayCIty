{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "traderelaycity",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/app", "/app/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "traderelaycity", "database_id": "REPLACE_AFTER_CREATING_D1", "migrations_dir": "migrations" }
  ],
  "env": {
    "staging": {
      "name": "traderelaycity",
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "traderelaycity-staging", "database_id": "da53b2ba-c0f2-43b8-befa-0d0a0eca3d3b", "migrations_dir": "migrations" }
      ],
      "vars": {
        "SIMULATION_MODE": "false",
        "APP_BASE_URL": "https://traderelaycity.service-heyywebb.workers.dev",
        "AI_PROVIDER": "groq",
        "AI_MODEL": "openai/gpt-oss-20b",
        "AI_FALLBACK_PROVIDER": "gemini",
        "AI_FALLBACK_MODEL": "gemini-3.8-flash"
      }
    }
  }
}
