SIMULATION_MODE=true
# Both assistants use this Worker-side configuration for optional AI question interpretation.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_FALLBACK_PROVIDER=gemini
AI_FALLBACK_MODEL=gemini-3.8-flash
# Add GROQ_API_KEY and GEMINI_API_KEY only to your private .dev.vars.
# Hosted keys belong in Worker secrets. Never use VITE_ variables for keys.
